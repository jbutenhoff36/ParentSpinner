# Postgres connection string (Neon, Supabase, Render, Railway, or local)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to true for hosted databases that need SSL without a CA file (e.g. some Neon/Render setups)
DATABASE_SSL=false
# Long random string used to sign login cookies. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Port the server listens on (most hosts set this for you)
PORT=5000
# Time zone used for "one good day per calendar day" (e.g. America/Chicago)
APP_TIMEZONE=America/Chicago
# Optional: Sign in with Google (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
